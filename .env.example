# GRIME environment configuration — copy to .env and fill in.
# .env is gitignored; never commit a real token.

# Mapbox publishable token (pk.*) for the dashboard/explorer map.
# Free at https://account.mapbox.com/  — restrict it by URL before public deploy.
MAPBOX_TOKEN=

# Census Bureau API key (free, instant): https://api.census.gov/data/key_signup.html
# Used by the population-density and EJ-index features (core/generation.py,
# core/impact.py). Optional — without it those features fall back to defaults.
CENSUS_API_KEY=

# Optional: lock CORS to a single origin before serving the API publicly (M8).
# Leave unset for the open local-dev default (allow_origins=["*"]).
GRIME_ALLOWED_ORIGIN=
